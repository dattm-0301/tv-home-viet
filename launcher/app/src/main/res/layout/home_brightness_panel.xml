<?xml version="1.0" encoding="utf-8"?>
<!-- Quick brightness panel under the dock: value, auto-dim toggle, slider, three presets. BrightnessPanel drives it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/brightnessOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="76dp"
        android:background="#8C04050A" />

    <LinearLayout
        android:layout_width="@dimen/home_bright_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="81dp"
        android:layout_marginEnd="@dimen/home_side_margin"
        android:background="@drawable/home_bright_bg"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="15dp"
        android:paddingEnd="17dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HomePanelText"
                    android:fontFamily="@font/ui_bold"
                    android:text="Độ sáng màn hình"
                    android:textColor="@color/home_accent"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/brightValue"
                    style="@style/HomePanelText"
                    android:layout_marginTop="-7dp"
                    android:layout_marginBottom="-9dp"
                    android:fontFamily="@font/playfair_bold"
                    android:fontFeatureSettings="lnum,tnum"
                    android:textSize="@dimen/home_bright_value_text" />
            </LinearLayout>

            <!-- Auto-dim after 22:00 -->
            <LinearLayout
                android:id="@+id/brightAuto"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/home_bright_toggle_row"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="8dp">

                <FrameLayout
                    android:id="@+id/brightAutoSwitch"
                    android:layout_width="22dp"
                    android:layout_height="13dp"
                    android:background="@drawable/home_switch_track">

                    <View
                        android:id="@+id/brightAutoKnob"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginStart="1.5dp"
                        android:layout_marginEnd="1.5dp"
                        android:background="@drawable/home_switch_knob" />
                </FrameLayout>

                <TextView
                    android:id="@+id/brightAutoText"
                    style="@style/HomePanelText"
                    android:layout_marginStart="5dp"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/ui_medium"
                    android:text="Tự giảm sau 22:00"
                    android:textColor="@color/pill_text"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <com.gathin.tvhome.BrightnessSlider
            android:id="@+id/brightSlider"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="13dp"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                style="@style/HomePanelText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/ui_medium"
                android:text="Tối"
                android:textColor="@color/home_text_70"
                android:textSize="9sp" />

            <TextView
                style="@style/HomePanelText"
                android:fontFamily="@font/ui_medium"
                android:text="Sáng"
                android:textColor="@color/home_text_70"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/brightPresets"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/brightHint"
            style="@style/HomePanelText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/ui_medium"
            android:text="◀ ▶ Chỉnh   ·   ▼ Chọn mức sẵn   ·   Back Đóng"
            android:textColor="@color/home_text_70"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>

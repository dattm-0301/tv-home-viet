<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@color/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- Home redesign: a status button in the top dock, two lines (label, value) set by DockText. -->
    <style name="HomeStatusButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/home_status_height</item>
        <item name="android:maxWidth">@dimen/home_status_max_width</item>
        <item name="android:paddingStart">@dimen/home_status_pad_start</item>
        <item name="android:paddingEnd">@dimen/home_status_pad_end</item>
        <item name="android:drawablePadding">@dimen/home_status_icon_gap</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:background">@drawable/home_status_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">@dimen/home_status_value_text</item>
        <item name="android:fontFamily">@font/ui_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeRoundButton">
        <item name="android:layout_width">@dimen/home_round_button</item>
        <item name="android:layout_height">@dimen/home_round_button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/home_round_bg</item>
        <item name="android:drawableTint">@color/pill_text</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeDockDivider">
        <item name="android:layout_width">0.75dp</item>
        <item name="android:layout_height">@dimen/home_dock_divider_height</item>
        <item name="android:layout_marginStart">@dimen/home_dock_gap</item>
        <item name="android:layout_marginEnd">@dimen/home_dock_gap</item>
        <item name="android:background">@color/home_glass_stroke</item>
    </style>

    <!-- Single-line text straight on the photo: white with a soft shadow for contrast. -->
    <style name="HomeOnPhoto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">9</item>
    </style>

    <!-- Single-line text on glass. -->
    <style name="HomePanelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/home_text</item>
    </style>

    <style name="HomePill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/home_pill_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">7dp</item>
    </style>

    <style name="HomeHeaderButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/home_header_button_bg</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableTint">@color/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/ui_bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">@dimen/home_header_button_text</item>
    </style>
</resources>

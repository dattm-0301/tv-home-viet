<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only: the default layout with the race panel mirrored. Keep in step with layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginEnd="60dp"
        android:gravity="right"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/be_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/be_medium"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@font/be_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/be_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Darkens the photo while the widget is collapsed (HomeRails, "Thu gọn widget khi cuộn"). -->
    <View
        android:id="@+id/collapsedScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#8004050A"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/homeColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_side_margin"
        android:paddingEnd="@dimen/home_side_margin"
        android:paddingTop="@dimen/home_panel_top"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Widget row: clock and calendar on the photo, weather and prices on glass (HomeDashboard). -->
        <include layout="@layout/home_dashboard" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8D2AA"
            android:textSize="11sp"
            android:fontFamily="@font/plus_jakarta"
            android:visibility="gone" />

        <!-- Apps header: title and count on the left; Sort and New group (or the sort-mode hint) on the right. -->
        <RelativeLayout
            android:id="@+id/appsHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_apps_header_height"
            android:layout_marginTop="@dimen/home_apps_header_top"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Title and count share a baseline; the pair is centred in the header. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/appsTitle"
                    style="@style/HomeOnPhoto"
                    android:fontFamily="@font/playfair_italic"
                    android:text="@string/home_apps_title"
                    android:textSize="@dimen/home_apps_title_text" />

                <TextView
                    android:id="@+id/appsCount"
                    style="@style/HomeOnPhoto"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/ui_bold"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/home_accent"
                    android:textSize="@dimen/home_apps_count_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/headerButtons"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/HomeHeaderButton"
                    android:drawableStart="@drawable/ic_sort"
                    android:text="@string/home_sort" />

                <TextView
                    android:id="@+id/btnOrder"
                    style="@style/HomeHeaderButton"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_order"
                    android:text="Thứ tự" />

                <TextView
                    android:id="@+id/btnFilter"
                    style="@style/HomeHeaderButton"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_filter"
                    android:text="Lọc" />

                <TextView
                    android:id="@+id/btnNewGroup"
                    style="@style/HomeHeaderButton"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_folder_plus"
                    android:text="@string/home_new_group" />
            </LinearLayout>

            <!-- Shown instead of the buttons while sort mode is on. -->
            <TextView
                android:id="@+id/reorderHint"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:background="@drawable/home_hint_bg"
                android:ellipsize="end"
                android:fontFamily="@font/ui_bold"
                android:gravity="center_vertical"
                android:maxWidth="560dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:singleLine="true"
                android:textColor="@color/home_on_accent"
                android:textSize="@dimen/home_header_button_text"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- The original app grid: kept for its app list, library and card logic, but never shown; the rails below
             replace it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- App rails (HomeRails): one row per group; groups of fewer than 3 apps share a row. -->
    <ScrollView
        android:id="@+id/railsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/home_rails_top"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/railsColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="60dp" />
    </ScrollView>

    <!-- Bottom fade: there is more to scroll to. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_gravity="bottom"
        android:background="@drawable/home_bottom_fade"
        android:importantForAccessibility="no" />

    <!-- Top left, Home: greeting by time of day, then air quality and the next sunrise. -->
    <LinearLayout
        android:id="@+id/homeTopLeft"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/home_side_margin"
        android:layout_marginTop="@dimen/home_greeting_top"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/homeGreeting"
            style="@style/HomeOnPhoto"
            android:layout_marginTop="@dimen/home_greeting_trim"
            android:layout_marginBottom="@dimen/home_greeting_trim"
            android:fontFamily="@font/dancing_bold"
            android:paddingEnd="3dp"
            android:textSize="@dimen/home_greeting_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_pill_height"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/aqiPill"
                style="@style/HomePill">

                <View
                    android:id="@+id/aqiDot"
                    android:layout_width="@dimen/home_pill_dot"
                    android:layout_height="@dimen/home_pill_dot"
                    android:background="@drawable/home_dot" />

                <TextView
                    android:id="@+id/aqiValue"
                    style="@style/HomePanelText"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/ui_bold"
                    android:textSize="@dimen/home_pill_text" />

                <TextView
                    android:id="@+id/aqiLabel"
                    style="@style/HomePanelText"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/ui_medium"
                    android:textColor="@color/home_text_80"
                    android:textSize="@dimen/home_pill_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sunrisePill"
                style="@style/HomePill"
                android:layout_marginStart="6dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sunrise" />

                <TextView
                    android:id="@+id/sunriseText"
                    style="@style/HomePanelText"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/ui_medium"
                    android:textColor="@color/home_text_80"
                    android:textSize="@dimen/home_pill_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Top left, collapsed: time, date and lunar day, temperature and rain in one strip. -->
    <LinearLayout
        android:id="@+id/compactBar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_dock_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/home_side_margin"
        android:layout_marginTop="@dimen/home_dock_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextClock
            android:id="@+id/compactClock"
            style="@style/HomeOnPhoto"
            android:layout_marginTop="@dimen/home_compact_time_trim"
            android:layout_marginBottom="@dimen/home_compact_time_trim"
            android:fontFamily="@font/playfair_bold"
            android:fontFeatureSettings="lnum,tnum"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="@dimen/home_compact_time_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compactDate"
                style="@style/HomeOnPhoto"
                android:ellipsize="end"
                android:fontFamily="@font/ui_bold"
                android:maxWidth="230dp"
                android:textSize="@dimen/home_compact_line_text" />

            <TextView
                android:id="@+id/compactWeather"
                style="@style/HomeOnPhoto"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/ui_medium"
                android:maxWidth="230dp"
                android:textColor="#D9FFFFFF"
                android:textSize="@dimen/home_compact_sub_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top dock: one glass capsule with Inputs, network and brightness (label + value) and two round buttons. -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_dock_height"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/home_dock_top"
        android:layout_marginEnd="@dimen/home_side_margin"
        android:background="@drawable/home_dock_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/home_dock_padding"
        android:paddingEnd="@dimen/home_dock_padding">

        <TextView android:id="@+id/btnInputs" style="@style/HomeStatusButton"
            android:drawableStart="@drawable/home_well_input"
            android:contentDescription="@string/inputs" />

        <View android:id="@+id/dockDivider1" style="@style/HomeDockDivider" />

        <TextView android:id="@+id/btnWifi" style="@style/HomeStatusButton"
            android:drawableStart="@drawable/home_well_wifi" />

        <View android:id="@+id/dockDivider2" style="@style/HomeDockDivider" />

        <TextView android:id="@+id/btnBrightness" style="@style/HomeStatusButton"
            android:drawableStart="@drawable/home_well_brightness"
            android:contentDescription="@string/home_brightness" />

        <View android:id="@+id/dockDivider3" style="@style/HomeDockDivider" />

        <TextView android:id="@+id/btnLibraryTop" style="@style/HomeRoundButton"
            android:visibility="gone" android:contentDescription="@string/app_library"
            android:drawableStart="@drawable/ic_dock_apps" />

        <TextView android:id="@+id/btnSettings" style="@style/HomeRoundButton"
            android:layout_marginStart="@dimen/home_dock_gap"
            android:contentDescription="@string/settings"
            android:drawableStart="@drawable/ic_dock_settings" />
    </LinearLayout>

    <!-- Quick brightness panel, opened from the dock's Độ sáng segment (BrightnessPanel). -->
    <include layout="@layout/home_brightness_panel" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
